# Default: normalize line endings on checkout
* text=auto

# Shell scripts — always LF
mvnw         text eol=lf
*.sh         text eol=lf

# Windows scripts — always CRLF
mvnw.cmd     text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Source and config — always LF
*.java       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.sql        text eol=lf
*.properties text eol=lf
*.txt        text eol=lf
*.http       text eol=lf

# Binary — do not mangle
*.jar        binary
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.zip        binary
