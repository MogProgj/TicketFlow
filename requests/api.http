@baseUrl = http://localhost:8080
@ticketId = 1

### Health check
GET {{baseUrl}}/health

### Create a ticket
POST {{baseUrl}}/tickets
Content-Type: application/json

{
	"title": "Login page returns 500",
	"description": "Users see an internal server error on the login page.",
	"priority": "P1",
	"assignee": "alice"
}

### List tickets
GET {{baseUrl}}/tickets?status=OPEN&priority=P1&q=login

### Get a ticket by ID
GET {{baseUrl}}/tickets/{{ticketId}}

### Update a ticket status with a valid transition
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"status": "IN_PROGRESS"
}

### Update a ticket with an invalid transition
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"status": "CLOSED"
}

### Get ticket events
GET {{baseUrl}}/tickets/{{ticketId}}/events
