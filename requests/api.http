@baseUrl = http://localhost:8080
@ticketId = 1

### Root API info
GET {{baseUrl}}/

### Health check
GET {{baseUrl}}/health

### Create a ticket
POST {{baseUrl}}/tickets
Content-Type: application/json

{
	"title": "Login page returns 500",
	"description": "Users see an internal server error on the login page.",
	"priority": "P1",
	"assignee": "alice"
}

### List all tickets
GET {{baseUrl}}/tickets

### List tickets filtered by status
GET {{baseUrl}}/tickets?status=OPEN

### List tickets filtered by priority
GET {{baseUrl}}/tickets?priority=P1

### Search tickets by query (matches title or description)
GET {{baseUrl}}/tickets?q=login

### Combined filter + search
GET {{baseUrl}}/tickets?status=OPEN&priority=P1&q=login

### Get a ticket by ID
GET {{baseUrl}}/tickets/{{ticketId}}

### Update a ticket status with a valid transition
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"status": "IN_PROGRESS"
}

### Update a ticket title and description
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"title": "Login flow returns 500 on submit",
	"description": "Reproduced on staging with valid credentials."
}

### Re-assign a ticket
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"assignee": "bob"
}

### Clear assignee (blank string clears to null)
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"assignee": ""
}

### Update a ticket with an invalid transition (returns 400)
PATCH {{baseUrl}}/tickets/{{ticketId}}
Content-Type: application/json

{
	"status": "CLOSED"
}

### Create a comment
POST {{baseUrl}}/tickets/{{ticketId}}/comments
Content-Type: application/json

{
	"author": "alice",
	"body": "Reproduced on staging."
}

### List comments
GET {{baseUrl}}/tickets/{{ticketId}}/comments

### Get ticket events (audit timeline)
GET {{baseUrl}}/tickets/{{ticketId}}/events
